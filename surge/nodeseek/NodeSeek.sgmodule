#!name=NodeSeek 签到
#!desc=Cookie 捕获 + 每日定时签到。默认每天 10:00、随机鸡腿；访问 NodeSeek 个人页自动保存请求头。修改 cronexp 可调整时间，将签到脚本的 argument 改为 fixed=true 可固定 5 鸡腿。
#!author=Nullwhy / Curtinp118（Surge 适配：yiyu12138）
#!homepage=https://github.com/Nullwhy/Egern
#!icon=https://raw.githubusercontent.com/Nullwhy/Egern/main/Icon/Nullwhy.png
#!category=签到

[Script]
NodeSeek Cookie = type=http-response, pattern=^https://www\.nodeseek\.com/api/account/getInfo/, script-path=https://raw.githubusercontent.com/yiyu12138/ziyong/main/surge/nodeseek/NodeSeek.js, requires-body=0, timeout=30, argument=capture=true
NodeSeek 签到 = type=cron, cronexp="0 10 * * *", script-path=https://raw.githubusercontent.com/yiyu12138/ziyong/main/surge/nodeseek/NodeSeek.js, timeout=60, argument=fixed=false

[MITM]
hostname = %APPEND% www.nodeseek.com
